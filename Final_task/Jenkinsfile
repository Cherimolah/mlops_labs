// Jenkins-пайплайн ежедневного автообновления датасета и переобучения при сдвиге данных.
//
// Логика:
//   1. Раз в сутки (cron) скачиваем свежий датасет с Kaggle (mlurfuflat).
//   2. [NEW] Версионируем его через DVC и синхронизируем с remote-хранилищем.
//   3. Считаем метрики дрейфа (PSI / KS / Jensen-Shannon) относительно эталона.
//   4. Если обнаружен сдвиг данных — переобучаем модель и публикуем артефакты.
//   5. Если сдвига нет — модель не трогаем.
//
// Требуемые Jenkins-credentials:
//   'kaggle-api'   — Username with password  (username = Kaggle user, password = API key)
//   'aws-s3-dvc'   — Username with password  (username = AWS_ACCESS_KEY_ID,
//                                              password = AWS_SECRET_ACCESS_KEY)
//                    Замените на нужный credential для GCS / Azure / SSH,
//                    если используете другой DVC-remote.

pipeline {
    agent any

    triggers {
        // Раз в день, Jenkins сам разнесёт нагрузку по времени (H).
        cron('H 3 * * *')
    }

    environment {
        // --- Kaggle ---
        KAGGLE     = credentials('kaggle-api')   // -> KAGGLE_USR / KAGGLE_PSW
        KAGGLE_USERNAME = "${KAGGLE_USR}"
        KAGGLE_KEY      = "${KAGGLE_PSW}"

        // --- DVC remote (S3) ---
        AWS        = credentials('aws-s3-dvc')   // -> AWS_USR / AWS_PSW
        AWS_ACCESS_KEY_ID     = "${AWS_USR}"
        AWS_SECRET_ACCESS_KEY = "${AWS_PSW}"
        AWS_DEFAULT_REGION    = 'us-east-1'      // при необходимости смените регион

        PYTHON = 'python'

        GIT_AUTHOR_NAME  = 'Jenkins CI'
        GIT_AUTHOR_EMAIL = 'jenkins@example.com'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    runCmd("${PYTHON} -m venv .venv")
                    def py = pyBin()
                    runCmd("${py} -m pip install --upgrade pip")
                    runCmd("${py} -m pip install -r requirements.txt -r requirements-pipeline.txt")
                }
            }
        }

        stage('DVC pull') {
            steps {
                script {
                    runCmd("${pyBin()} scripts/dvc_push.py pull")
                }
            }
        }

        // ------------------------------------------------------------------ //
        stage('Download data') {
            steps {
                script {
                    runCmd("${pyBin()} scripts/download_data.py")
                }
            }
        }

        stage('DVC add & push') {
            steps {
                script {
                    runCmd("git config user.name  \"${env.GIT_AUTHOR_NAME}\"")
                    runCmd("git config user.email \"${env.GIT_AUTHOR_EMAIL}\"")

                    def rc = runCmdStatus("${pyBin()} scripts/dvc_push.py add")
                    if (rc != 0) {
                        error('Не удалось зарегистрировать данные в DVC (dvc add)')
                    }
                    rc = runCmdStatus("${pyBin()} scripts/dvc_push.py push")
                    if (rc != 0) {
                        error('Не удалось загрузить данные в DVC remote (dvc push)')
                    }
                }
            }
        }

        // ------------------------------------------------------------------ //
        stage('Detect drift') {
            steps {
                script {
                    // drift_detection.py: код 0 — дрейфа нет, 10 — дрейф, 1 — ошибка.
                    def status = runCmdStatus("${pyBin()} scripts/drift_detection.py")
                    if (status == 1) {
                        error('Ошибка при расчёте дрейфа данных')
                    }
                    env.DRIFT_DETECTED = fileExists('RETRAIN_REQUIRED') ? 'true' : 'false'
                    echo "Сдвиг данных обнаружен: ${env.DRIFT_DETECTED}"
                }
            }
        }

        stage('Retrain') {
            when { expression { env.DRIFT_DETECTED == 'true' } }
            steps {
                script {
                    echo 'Обнаружен сдвиг данных — переобучаю модель.'
                    runCmd("${pyBin()} train.py")
                }
            }
        }

        stage('DVC push reference') {
            when { expression { env.DRIFT_DETECTED == 'true' } }
            steps {
                script {
                    def rc = runCmdStatus("${pyBin()} scripts/dvc_push.py add")
                    if (rc != 0) {
                        error('Не удалось зарегистрировать reference.csv в DVC')
                    }
                    rc = runCmdStatus("${pyBin()} scripts/dvc_push.py push")
                    if (rc != 0) {
                        error('Не удалось загрузить reference.csv в DVC remote')
                    }
                }
            }
        }

        // ------------------------------------------------------------------ //
        stage('Publish model') {
            when { expression { env.DRIFT_DETECTED == 'true' } }
            steps {
                archiveArtifacts artifacts: 'models/*.joblib, models/metrics.json, data/reference.csv.dvc',
                                 fingerprint: true
                // Здесь же можно пересобрать и задеплоить Docker-образ, например:
                //   runCmd('docker build -t apartment-predictor:latest .')
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'drift_report.json', allowEmptyArchive: true
        }
        success {
            echo "Готово. Переобучение: ${env.DRIFT_DETECTED}"
        }
        failure {
            echo 'Пайплайн упал — см. лог выше.'
        }
    }
}

// --- Кросс-платформенные помощники (Linux/Windows агенты Jenkins) ---

def pyBin() {
    return isUnix() ? '.venv/bin/python' : '.venv\\Scripts\\python'
}

def runCmd(String cmd) {
    if (isUnix()) {
        sh cmd
    } else {
        bat cmd
    }
}

def runCmdStatus(String cmd) {
    if (isUnix()) {
        return sh(script: cmd, returnStatus: true)
    } else {
        return bat(script: cmd, returnStatus: true)
    }
}
